{
    "name": "datatables.net-buttons-jqui",
    "description": "Buttons for DataTables with styling for [jQueryUI](http://jqueryui.com/)",
    "main": "./js/buttons.jqueryui.js",
    "module": "./js/buttons.jqueryui.mjs",
    "style": "./css/buttons.jqueryui.css",
    "types": "./types/buttons.jqueryui.d.ts",
    "version": "4.1.1",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "Buttons",
        "Column Visibility",
        "csv",
        "excel",
        "pdf",
        "print",
        "jQuery UI",
        "jQueryUI",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-buttons": "4.1.1",
        "datatables.net-jqui": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/Buttons.git"
    },
    "exports": {
        ".": {
            "types": "./types/buttons.jqueryui.d.ts",
            "import": "./js/buttons.jqueryui.mjs",
            "default": "./js/buttons.jqueryui.mjs",
            "require": "./js/buttons.jqueryui.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/buttons.jqueryui.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}